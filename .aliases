# Personal

# OS / shell detection, used by per-alias conditionals below
[[ $OSTYPE == darwin* ]] && IS_MAC=1 || IS_MAC=
[[ -n $ZSH_VERSION ]] && IS_ZSH=1 || IS_ZSH=

#echo "personal aliases"

if [[ -z $IS_MAC ]]; then
    vnckill(){
        vncserver -kill :$1
    }
fi
alias g="git"
if [[ -n $IS_MAC ]]; then
    alias ls="ls -G"
else
    alias ls="ls --color=auto"
fi
alias ll="ls -lha"
alias lld="ls -lhad"
alias llt="ls -lhatr"
e(){
    emacs $@ &
}
if [[ -z $IS_MAC ]]; then
    xt(){
        local name=${1:-xterm}
        LABEL=$name xterm -T "$name" -n "$name" &
    }
fi
alias gr="git rev-parse --show-toplevel"
alias grtmp='(cd "$(gr)" && mkdir -p tmp && touch tmp/README && cursor tmp/README)'
if [[ -n $IS_ZSH ]]; then
    alias h="history -20"
else
    alias h="history 20"
fi
alias l="less -i "
mcd(){
    mkdir -pv $1 && cd $1
}
if [[ -n $IS_ZSH ]]; then
    alias clean="rm -fv {,.}{*~,#*#}(N)"
else
    alias clean="rm -fv {,.}{*~,#*#}"
fi
[[ -z $IS_MAC ]] && alias myxrdb="xrdb -cpp cpp -load ~/.Xresources"
alias j="jobs -l"
wta(){
    git worktree add -b $1 $1 $2 && cd $1
}
wtao(){
    if [ "$#" -ne 1 ]; then
        echo "Usage: wtao <branch>" >&2
        return 1
    fi
    wta $1 origin/$1
}
relabel(){
    export LABEL="$@"
    echo -ne "\033]0;$@\007"
}
alias rlbn='relabel $(basename $(gr))'
rps(){
    git rev-parse --short=4 $1
}
alias isgit="git rev-parse --is-inside-work-tree >& /dev/null"
alias gd="git diff"
alias gdn="gd --name-only "
alias brn="git branch --show-current "
alias gs="git status"
alias gg="git grep"
alias gl="git log --no-merges"
alias gp="git pull --prune"
alias gfg="git fetch && git"
alias gf="git fetch --prune"
alias mc='git diff --name-only --diff-filter=U'
alias gm="git merge --no-edit"
if [[ -n $IS_ZSH ]]; then
    alias hg="history 1 | grep"
else
    alias hg="history | grep"
fi
newname(){
    local NUM=0
    local FILE=$1
    if [ -e "$1" ]; then
        while [ -e "${1}.$NUM" ]; do
            ((NUM++))
        done
        FILE=${1}.$NUM
    fi
    echo $FILE
}
if [[ -n $IS_MAC ]]; then
    alias xc="pbpaste"
else
    alias xc="xclip -o"
fi
alias sp="for f in {1..5} ; do echo ; done"
alias cdrp='cd `realpath $PWD`'
if [[ -n $IS_MAC ]]; then
    alias mdps='ps -eo pid,ppid,pcpu,etime,user,command '
else
    alias mdps='ps -eo pid,ppid,pcpu,etime,user,cmd '
fi
alias ldir='ll | grep "^d"'
awkp(){
    pattern="$1"
    shift

    matched=0

    for file in "$@"; do
        if [[ ! -f "$file" ]]; then
            #echo "Skipping: $file (not a regular file)" >&2
            continue
        fi

        awk -v pat="$pattern" -v file="$file" '
        BEGIN {RS=""; FS="\n"}  # Paragraph mode
        {
            if ($0 ~ pat) {
                matched=1
                print "==> " file " <=="
                print $0 "\n"
            }
        }
        END { exit !matched }' "$file" && matched=1
    done
    return $((matched == 1 ? 0 : 1))
}

alias wat="watch -n 60 "
if [[ -n $IS_MAC ]]; then
    # macOS (brew) pstree is a different program: -w wide, -p <pid> = branches containing pid
    alias pstree="pstree -w -p "
else
    alias pstree="pstree -lpas "
fi

pstreefull(){
    mdps | head -1
    local pids
    if [[ -n $IS_MAC ]]; then
        # mac format: " \-+= 12345 user cmd"  -> first numeric field
        pids=$(pstree $1 | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/){print $i; break}}')
    else
        # linux format: "name,12345 args"
        pids=$(pstree $1 | cut -d ',' -f 2 | cut -d ' ' -f 1)
    fi
    for f in $pids; do
        mdps | grep -E "^ *$f "
    done
}

if [[ -n $IS_MAC ]]; then
    # BSD sed: needs -i '', no \t or \+ in regex
    nows(){ sed -i '' -E -e $'s/\t/   /g' -e 's/[[:space:]]+$//' "$@"; }
else
    alias nows="sed -i -e 's/\t/   /g' -e 's/[[:space:]]\+$//' "
fi
# -L follows links
if [[ -n $IS_MAC ]]; then
    alias latest='find -L . -type f -exec stat -f "%m %N" {} + 2>/dev/null | sort -nr | head -n 30 | while read ts file; do echo "$(date -r "$ts" "+%Y-%m-%d %H:%M:%S") $file"; done'
else
    alias latest='find -L . -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 30  | while read ts file; do echo "$(date -d @"$ts" "+%Y-%m-%d %H:%M:%S") $file"; done'
fi
_tm_try(){
    local base="$1"
    local n="$2"
    local session_name
    if [ "$n" -eq 0 ]; then
        session_name="$base"
    else
        session_name="${base}_$((n - 1))"
    fi
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        if [ -n "$VSCODE_IPC_HOOK_CLI" ]; then
            echo "export VSCODE_IPC_HOOK_CLI=\"$VSCODE_IPC_HOOK_CLI\"" > /tmp/tmux.$session_name
            chmod +x /tmp/tmux.$session_name
        fi
        tmux new-session -s "$session_name"
        return
    fi
    local clients
    clients=$(tmux list-clients -t "$session_name" 2>/dev/null | wc -l)
    if [ "${clients:-0}" -eq 0 ]; then
        tmux attach -t "$session_name"
        return
    fi
    _tm_try "$base" $((n + 1))
}
tm(){
    local session_name="${1:-$(basename "$(gr)")}"
    session_name="${session_name//./_}"
    _tm_try "$session_name" 0
}
alias mylsof='sp; lsof 2>/dev/null | grep -E "(COMMAND|\(deleted\))";lsof 2>/dev/null|head -1'
if [[ -n $IS_ZSH ]]; then
    alias pause='read -k 1 -s'
else
    alias pause='read -n 1 -s -r'
fi
